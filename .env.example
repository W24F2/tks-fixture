# Sports Fixtures - Environment Variables
# Copy this to .env and fill in your values

# Flask
SECRET_KEY=your-super-secret-key-change-in-production
FLASK_ENV=production

# Database - SQLAlchemy connection string (required)
# SQLite (development)
DATABASE_URL=sqlite:///instance/app.db
# MySQL (production)
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/dbname?charset=utf8mb4
# PostgreSQL
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Oracle
# DATABASE_URL=oracle+oracledb://user:pass@host:1521/?service_name=XE

# Trumba XML Source (required for scraping)
TRUMBA_XML_URL=https://your-trumba-xml-url.com/feed.xml

# Redis (for caching and rate limiting in production)
# REDIS_URL=redis://localhost:6379/0

# Gunicorn (optional overrides)
# GUNICORN_BIND=127.0.0.1:5002
# GUNICORN_WORKERS=5
# GUNICORN_THREADS=4