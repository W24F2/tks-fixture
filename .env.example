# Sports Fetcher - Environment Variables
# Copy this to .env and fill in your values

# Flask
SECRET_KEY=your-super-secret-key-change-in-production
FLASK_ENV=production

# Database (choose one)
# Option 1: PostgreSQL (standard)
DB_HOST=your-db-host
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=fixtures

# Option 2: Oracle Database
# ORACLE_USER=your-user
# ORACLE_PASSWORD=your-password
# ORACLE_HOST=your-oracle-host
# ORACLE_PORT=1521
# ORACLE_SERVICE_NAME=your-service-name

# Option 3: Full connection string (Vercel/Neon style)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Trumba XML Source (required)
TRUMBA_XML_URL=https://your-trumba-xml-url.com/feed.xml

# Redis (for caching and rate limiting in production)
# REDIS_URL=redis://localhost:6379/0

# Gunicorn (optional overrides)
# GUNICORN_BIND=127.0.0.1:5002
# GUNICORN_WORKERS=5
# GUNICORN_THREADS=4