# Sports Fixtures Dashboard Environment Configuration

# XML Feed URL
XML_FEED_URL=https://example.com/sports-fixtures.xml

# API Key (optional)
XML_API_KEY=

# Username (optional)
XML_USERNAME=

# Password (optional)
XML_PASSWORD=

# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# Secret key for Flask app
SECRET_KEY=change-this